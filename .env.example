# Porta HTTP do BFF (prefixo /api)
PORT=3000
NODE_ENV=development

# Autenticação: dev (JWT HS256 + personas do seed) ou entra (Microsoft Entra ID / JWKS)
AUTH_MODE=dev
# Segredo HS256 do modo dev (mínimo 32 caracteres)
JWT_SECRET=troque-este-segredo-dev-com-32-caracteres-ou-mais
# Modo entra
ENTRA_TENANT_ID=
ENTRA_AUDIENCE=
# Com NODE_ENV=production e AUTH_MODE=dev o BFF só sobe se esta flag for true
ALLOW_DEV_AUTH_IN_PRODUCTION=false

# Serviços a jusante
MS_FILA_URL=http://localhost:8081
MS_PRONTUARIO_URL=http://localhost:8082
FN_VISAO_URL=http://localhost:7071
INTERNAL_API_KEY=dev-internal-key
UPSTREAM_TIMEOUT_MS=3000

# Origens permitidas (separadas por vírgula)
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
